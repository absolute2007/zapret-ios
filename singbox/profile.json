    },
    {
      "server": "127.0.0.1",
      "server_port": 10920,
      "tag": "zapret-1",
      "type": "socks",
      "version": "5"
    },
    {
      "server": "127.0.0.1",
      "server_port": 10921,
      "tag": "zapret-2",
      "type": "socks",
      "version": "5"
    },
    {
      "server": "127.0.0.1",
      "server_port": 10922,
